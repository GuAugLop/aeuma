node_modules/
.env
*.log

# Banco e arquivos enviados pelo painel — conteúdo local, não versionado
data/db.json
data/db.json.tmp
data/.segredo-dev
# Um só asterisco em cada nível: "data/uploads/**/*" casaria também com as pastas,
# e o git não entra em pasta ignorada — os .gitkeep nunca seriam versionados.
data/uploads/*/*
!data/uploads/*/.gitkeep

# Python
__pycache__/
*.pyc
