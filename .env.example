# Copie este arquivo para ".env" e ajuste os valores antes de publicar.

# Porta do servidor
PORTA=3000

# Ambiente: development | production
NODE_ENV=development

# Segredo usado para assinar o token de sessão do painel administrativo.
# OBRIGATÓRIO em produção. Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SEGREDO=

# Conta de administrador criada automaticamente na primeira execução.
ADMIN_EMAIL=admin@aeuma.com
ADMIN_NOME=Administrador AEUMA
ADMIN_SENHA=aeuma@2026

# Tamanho máximo de cada arquivo enviado, em megabytes
UPLOAD_MAX_MB=25
